// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/config/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique

  gmailConnected       Boolean   @default(false)
  calendarConnected    Boolean   @default(false)
  gmailConnectedAt     DateTime?
  calendarConnectedAt  DateTime?
  lastGmailSync        DateTime?
  lastCalendarSync     DateTime?
  onboardingCompleted  Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  preferences     UserPreference?
  emails          Email[]
  events          CalendarEvent[]
  agentExecutions AgentExecution[]
  chatSessions    ChatSession[]
  syncRecords     SyncRecord[]
}

model Email {
  id             String   @id @default(cuid())
  corsairEmailId String   @unique
  userId         String
  threadId       String?
  subject        String
  sender         String
  snippet        String?
  body           String?
  isRead         Boolean  @default(false)
  receivedAt     DateTime
  syncedAt       DateTime @default(now())

  user           User                 @relation(fields: [userId], references: [id])
  classification EmailClassification?
  summary        EmailSummary?
  drafts         EmailDraft[]

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model CalendarEvent {
  id             String   @id @default(cuid())
  corsairEventId String   @unique
  userId         String
  title          String
  description    String?
  location       String?
  startTime      DateTime
  endTime        DateTime
  meetingLink    String?
  status         String?
  organizer      String?
  attendees      Json?
  syncedAt       DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EmailClassification {
  id         String        @id @default(cuid())
  emailId    String        @unique
  priority   EmailPriority
  reason     String?
  summary    String?
  category   String?
  confidence Float?

  email      Email         @relation(fields: [emailId], references: [id])

  createdAt  DateTime      @default(now())
}

model EmailSummary {
  id            String   @id @default(cuid())
  emailId       String   @unique
  shortSummary  String
  mediumSummary String
  bulletSummary Json
  createdAt     DateTime @default(now())

  email         Email    @relation(fields: [emailId], references: [id])
}

model EmailDraft {
  id        String   @id @default(cuid())
  emailId   String
  content   String
  tone      String
  createdAt DateTime @default(now())

  email     Email    @relation(fields: [emailId], references: [id])

  @@index([emailId])
}

enum EmailPriority {
  URGENT
  IMPORTANT
  NORMAL
  LOW
}

model AgentExecution {
  id        String          @id @default(cuid())
  userId    String
  prompt    String
  result    Json?
  status    ExecutionStatus
  createdAt DateTime        @default(now())

  // FIXED: Collapsed onto a single line
  user      User            @relation(fields: [userId], references: [id])
}

enum ExecutionStatus {
  PENDING
  SUCCESS
  FAILED
}

model UserPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  theme              String?
  emailNotifications Boolean @default(true)
  keyboardShortcuts  Boolean @default(true)

  // FIXED: Collapsed onto a single line
  user               User    @relation(fields: [userId], references: [id])
}

// for corsair setup :


model CorsairIntegration {
  id        String           @id
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  name      String
  config    Json             @default("{}")
  dek       String?
  accounts  CorsairAccount[]

  @@map("corsair_integrations")
}

model CorsairAccount {
  id            String             @id
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  tenantId      String             @map("tenant_id")
  integrationId String             @map("integration_id")
  config        Json               @default("{}")
  dek           String?
  integration   CorsairIntegration @relation(fields: [integrationId], references: [id])
  entities      CorsairEntity[]
  events        CorsairEvent[]

  @@map("corsair_accounts")
}

model CorsairEntity {
  id         String         @id
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  accountId  String         @map("account_id")
  entityId   String         @map("entity_id")
  entityType String         @map("entity_type")
  version    String
  data       Json           @default("{}")
  account    CorsairAccount @relation(fields: [accountId], references: [id])

  @@map("corsair_entities")
}

model CorsairEvent {
  id        String         @id
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  accountId String         @map("account_id")
  eventType String         @map("event_type")
  payload   Json           @default("{}")
  status    String?
  account   CorsairAccount @relation(fields: [accountId], references: [id])

  @@map("corsair_events")
}

model WebhookLog {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  entityId    String?
  tenantId    String
  status      String
  error       String?
  processedAt DateTime @default(now())

  @@index([tenantId])
  @@index([processedAt])
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatSession {
  id            String        @id @default(cuid())
  userId        String
  title         String
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  messages      ChatMessage[]

  @@index([userId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─── Sync ─────────────────────────────────────────────────────────────────────

model SyncRecord {
  id          String     @id @default(cuid())
  userId      String
  integration String
  status      SyncStatus
  progress    Int        @default(0)
  total       Int        @default(0)
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  error       String?

  user        User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, integration])
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}